{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "snapcart/cart-icon",
	"version": "2.1.0",
	"title": "Snap Cart",
	"category": "woocommerce",
	"icon": "cart",
	"description": "A cart icon with a live item count that links straight to the cart.",
	"keywords": [ "cart", "basket", "bag", "snapcart", "woocommerce" ],
	"textdomain": "snapcart-for-woocommerce",
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"color": {
			"text": true,
			"background": false,
			"gradients": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css"
}
